<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.demo.HelloController">
   <center>
      <VBox alignment="CENTER" onMouseClicked="#onbotonsalido" prefHeight="453.0" prefWidth="486.0" spacing="20.0" BorderPane.alignment="CENTER">
          <padding>
              <Insets bottom="10.0" left="20.0" right="20.0" top="10.0" />
          </padding>
         <Label text="Introduce un elemento para la lista" />
         <FlowPane alignment="CENTER" hgap="25.0">
            <children>
               <TextField fx:id="inputtext" onKeyTyped="#onActivar" />
                <Button fx:id="btnAñadir" alignment="CENTER" contentDisplay="CENTER" onAction="#onbuttonAñadir" prefHeight="25.0" prefWidth="77.0" text="Añadir">
     </Button>
            </children>
         </FlowPane>
         <Button fx:id="btnVaciar" alignment="CENTER" contentDisplay="CENTER" mnemonicParsing="false" onAction="#onBotonVaciar" prefHeight="19.0" prefWidth="69.0" text="Vaciar" />
         <ListView fx:id="lisT" prefHeight="185.0" prefWidth="446.0" />
      
                               <Button fx:id="btnCerrar" onAction="#onBotonCerrar" prefHeight="45.0" prefWidth="105.0" text="Cerrar aplicacion">
     </Button>
      </VBox>
   </center>
   <top>
      <MenuBar BorderPane.alignment="CENTER">
        <menus>
          <Menu mnemonicParsing="false" text="Help" />
        </menus>
      </MenuBar>
   </top>
   <bottom>
      <Label text="Hecho por Hugo Roldan Moncayo" BorderPane.alignment="CENTER" />
   </bottom>
</BorderPane>
